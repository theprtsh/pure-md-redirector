{
  "manifest_version": 2,
  "name": "Pure.md Redirector",
  "version": "1.0",
  "description": "Prefix current URL with `pure.md/`",
  
  "permissions": [
    "activeTab",
    "tabs"
  ],
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "browser_action": {
    "default_title": "Open in Pure.md",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  
  "commands": {
    "open-pure-md": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Open current page in Pure.md"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
